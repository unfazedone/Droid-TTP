# ==============================================================================
# DroidTTP - Production Environment Configuration
# Copy this file to .env before deploying: cp .env.production.example .env
# ==============================================================================

# Core Analyst / Admin Authentication
DROIDTTP_USERNAME=analyst_admin
# Set a strong, unique production password (minimum 16 characters recommended)
DROIDTTP_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_PASSWORD

# Session Security Secret (REQUIRED: at least 32 cryptographically random characters)
# Generate with: openssl rand -base64 48
DROIDTTP_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_ABC123

# Role Assignment: analyst or admin
# Admin role is required to modify system settings and retention policies
DROIDTTP_ROLE=admin

# Data Storage Directory (holds SQLite database and private sample storage)
# When deploying with Docker Compose, this is mounted to /app/data
DROIDTTP_DATA_DIR=/app/data

# Maximum upload size for Android APKs in Megabytes (default: 200 MB)
# Make sure Nginx client_max_body_size is at least as large as this value
DROIDTTP_MAX_UPLOAD_MB=200

# Timeout bounding each isolated static-analysis worker run (seconds)
DROIDTTP_ANALYSIS_TIMEOUT_SECONDS=120

# Cookie Security: Set to 'true' in production when serving over HTTPS / SSL
DROIDTTP_COOKIE_SECURE=true

# Dynamic Analysis Integration (Default: false / disabled for defensive static analysis)
DROIDTTP_ENABLE_DYNAMIC=false
